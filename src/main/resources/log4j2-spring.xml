<?xml version="1.0"?>
<Configuration packages="com.newrelic.logging.log4j2">

	<Appenders>
		<Console name="Console" target="SYSTEM_OUT">
			<!-- THIS DOES NOT WORK! Use JsonTemplateLayout with custom json-layout file found in src/main/resources -->
			<JsonTemplateLayout eventTemplateUri="classpath:json-layout.json"/>

			<!-- THIS DOES NOT WORK! Use JsonTemplateLayout with default JsonLayout provided by log4j2 -->
<!--			<JsonTemplateLayout eventTemplateUri="classpath:JsonLayout.json"/>-->

			<!-- THIS WORKS! Use deprecated JsonLayout provided by log4j2 -->
<!--			<JsonLayout compact="true" />-->

		</Console>
	</Appenders>

	<Loggers>
		<Root level="INFO">
			<AppenderRef ref="Console"/>
		</Root>
	</Loggers>

</Configuration>
