<?xml version="1.0"?>
<Configuration packages="com.newrelic.logging.log4j2">

	<Appenders>
		<Console name="Console" target="SYSTEM_OUT">
			<!-- Use custom json-layout file found in src/main/resources -->
			<JsonTemplateLayout eventTemplateUri="classpath:json-layout.json"/>
			<!-- Use default JsonLayout provided by log4j2 -->
<!--			<JsonTemplateLayout eventTemplateUri="classpath:JsonLayout.json"/>-->
		</Console>
	</Appenders>

	<Loggers>
		<Root level="INFO">
			<AppenderRef ref="Console"/>
		</Root>
	</Loggers>

</Configuration>
